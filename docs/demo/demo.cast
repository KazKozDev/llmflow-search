[0.022, "o", "\r\n\u001b[38;2;103;148;254m\r\n██╗     ██╗     ███╗   ███╗ \u001b[38;2;81;115;205m███████╗██╗      ██████╗ ██╗    ██╗\r\n██║     ██║     ████╗ ████║ \u001b[38;2;81;115;205m██╔════╝██║     ██╔═══██╗██║    ██║\r\n██║     ██║     ██╔████╔██║ \u001b[38;2;81;115;205m█████╗  ██║     ██║   ██║██║ █╗ ██║\r\n██║     ██║     ██║╚██╔╝██║ \u001b[38;2;81;115;205m██╔══╝  ██║     ██║   ██║██║███╗██║\r\n███████╗███████╗██║ ╚═╝ ██║ \u001b[38;2;81;115;205m██║     ███████╗╚██████╔╝╚███╔███╔╝\r\n╚══════╝╚══════╝╚═╝     ╚═╝ \u001b[38;2;81;115;205m╚═╝     ╚══════╝ ╚═════╝  "]
