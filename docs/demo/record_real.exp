#!/usr/bin/expect -f
# Records a REAL llmflow-search session via asciinema.
# The question is typed at model selection — per llm.py logic:
#   non-digit input → _PENDING_INITIAL_TASK + default model auto-selected.

set timeout 600

# Start asciinema recording wrapping the real agent
spawn asciinema rec docs/demo/demo_real.cast \
    --cols 110 --rows 35 --overwrite \
    --command "LLMFLOW_SEARCH_FORCE_COLOR=1 uv run --no-sync python -m llmflow_search"

# Wait for model list to appear
expect "Pick model number"

# Type question directly — non-digit sets it as pending task,
# default model (gemma4:26b-mlx) gets selected automatically
sleep 0.5
send "What are the key new features in Python 3.13?\r"

# Wait for real agent to finish (MCP + Ollama + web search)
# Could take several minutes
expect "Steps:" {
    sleep 2
    send "exit\r"
}

expect eof
